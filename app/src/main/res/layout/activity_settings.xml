<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnBack"
            style="@style/MS.HeaderButton"
            android:text="@string/back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_title"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Wi-Fi Direct -->
        <LinearLayout style="@style/MS.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/MS.CardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/set_wifi_direct" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchWifiDirect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                style="@style/MS.Hint"
                android:text="@string/set_wifi_direct_hint" />

            <TextView
                style="@style/MS.Label"
                android:layout_marginTop="14dp"
                android:text="@string/set_name" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="monospace"
                    android:text="DIRECT-MS-"
                    android:textColor="@color/text_dim"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/editName"
                    style="@style/MS.Input"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:inputType="text"
                    android:maxLength="20" />
            </LinearLayout>

            <TextView
                style="@style/MS.Hint"
                android:text="@string/set_name_hint" />

            <TextView
                style="@style/MS.Label"
                android:layout_marginTop="14dp"
                android:text="@string/set_pass" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/editPass"
                    style="@style/MS.Input"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:inputType="textVisiblePassword"
                    android:maxLength="63" />

                <TextView
                    android:id="@+id/btnGenerate"
                    style="@style/MS.CopyButton"
                    android:layout_marginTop="6dp"
                    android:text="@string/set_generate" />
            </LinearLayout>

            <TextView
                style="@style/MS.Hint"
                android:text="@string/set_pass_hint" />

            <TextView
                style="@style/MS.Label"
                android:layout_marginTop="14dp"
                android:text="@string/set_band" />

            <RadioGroup
                android:id="@+id/radioBand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radio2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/band_2"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/radio5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/band_5"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/radioAuto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/band_auto"
                    android:textColor="@color/text" />
            </RadioGroup>
        </LinearLayout>

        <!-- Proxy -->
        <LinearLayout style="@style/MS.Card">

            <TextView
                style="@style/MS.CardTitle"
                android:text="@string/set_port" />

            <EditText
                android:id="@+id/editPort"
                style="@style/MS.Input"
                android:fontFamily="monospace"
                android:inputType="number"
                android:maxLength="5" />

            <TextView
                style="@style/MS.Hint"
                android:text="@string/set_port_hint" />
        </LinearLayout>

        <!-- Batterie -->
        <LinearLayout style="@style/MS.Card">

            <TextView
                style="@style/MS.CardTitle"
                android:text="@string/set_battery" />

            <TextView
                android:id="@+id/txtBatteryHint"
                style="@style/MS.Hint"
                android:text="@string/set_battery_hint" />

            <TextView
                android:id="@+id/btnBattery"
                style="@style/MS.HeaderButton"
                android:layout_marginTop="10dp"
                android:text="@string/set_battery" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnSave"
            style="@style/MS.HeaderButton"
            android:layout_width="match_parent"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_filled"
            android:gravity="center"
            android:text="@string/set_save"
            android:textColor="@color/bg" />
    </LinearLayout>
</ScrollView>
